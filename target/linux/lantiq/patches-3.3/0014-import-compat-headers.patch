+/* Port Control Register */
+
+/* General Purpose Control (16) */
+#define IFX_DMA_PCTRL_GPC                       (0x1 << 16)
+#define IFX_DMA_PCTRL_GPC_VAL(val)              (((val) & 0x1) << 16)
+
+/* Port Weight for Transmit Direction (14:12) */
+#define IFX_DMA_PCTRL_TXWGT                     (0x7 << 12)
