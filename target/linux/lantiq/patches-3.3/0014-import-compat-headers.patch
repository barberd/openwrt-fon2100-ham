+#define IFX_RCU_BE_PCIE0_PDI                     0x00000080  /* Configure PCIE PDI module in big endian */
+#define IFX_RCU_BE_PCIE1S                        0x00000100  /* Configure AHB slave port that connects to PCIe1 RC in big endian */
+#define IFX_RCU_BE_PCIE1_DBI                     0x00000200  /* Configure DBI1 module in big endian */
+#define IFX_RCU_BE_PCIE1_PDI                     0x00000400  /* Configure PCIE1 PDI module in big endian */
