+	IFX_uint16_t	mask_range;
+	/* Type Flag:  0 --> Mask/ 11-->Range */
+	IFX_uint8_t		mask_range_type;
+} IFX_PCE_APPL_TBL_t;
+
+typedef struct
+{
+   /* IP address byte 15:8 */
+   IFX_uint8_t               ip_msb[8];
+   /* Nibble mask */
+   IFX_uint16_t              mask;
+}IFX_PCE_IP_DASA_MSB_TBL_t;
+
+typedef struct
+{
+   /* IP address byte 7:0 */
+   IFX_uint8_t               ip_lsb[8];
+   /* Nibble mask */
+   IFX_uint16_t              mask;
+}IFX_PCE_IP_DASA_LSB_TBL_t;
