+#define IFX_ETHSW_MULTICAST_TABLE_ENTRY_ADD        _IOW(IFX_ETHSW_MAGIC, 0x3F, IFX_ETHSW_multicastTable_t)
+
+/**
+   Remove an host member from a multicast group. The multicast group entry
