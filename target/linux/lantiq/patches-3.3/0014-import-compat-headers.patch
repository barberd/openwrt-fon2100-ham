+/** \addtogroup SYS1_REGISTER
+   @{
+*/
+/* access macros */
+#define sys1_r32(reg) reg_r32(&sys1->reg)
+#define sys1_w32(val, reg) reg_w32(val, &sys1->reg)
+#define sys1_w32_mask(clear, set, reg) reg_w32_mask(clear, set, &sys1->reg)
