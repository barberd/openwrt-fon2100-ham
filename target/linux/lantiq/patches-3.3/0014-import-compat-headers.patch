+++ b/arch/mips/include/asm/ifx/ifx_regs.h
@@ -0,0 +1,262 @@
+/******************************************************************************
+**
+** FILE NAME    : ifx_regs.h
+** PROJECT      : IFX UEIP
+** MODULES      : BSP Basic
+**
+** DATE         : 27 May 2009
+** AUTHOR       : Xu Liang
+** DESCRIPTION  : common header file
+** COPYRIGHT    :       Copyright (c) 2009
