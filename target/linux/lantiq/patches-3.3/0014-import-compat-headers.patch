+typedef struct
+{
+	union {
+		/* Ethertype */
+		IFX_uint16_t	ethertype;
+		struct {
+			/* Protocol */
+			IFX_uint16_t	protocol:8;
+			/* Protocol Flags */
+			IFX_uint16_t	protocol_flags:8;
+		} prot;
+	} key;
+	union {
+		/* Ethertype Mask */
+		IFX_uint16_t	ethertype_mask;
+		struct {
+			/* reserved */
+			IFX_uint16_t	res:12;
+			/* Protocol Mask */
+			IFX_uint16_t	protocol_mask:2;
+			/* Protocol Flag Mask */
