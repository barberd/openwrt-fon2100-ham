+	ifx_sw_write_adm6996_smi(addr,dat);
+#else	//000001.joelin
+	#ifdef CONFIG_SWITCH_GPIO_ACCESS //605112:fchang.added
+		ifx_sw_write_tantos(addr,dat);
+	#endif //605112:fchang.added
+#endif	//000001.joelin
+	return 0;
+}
